; EAR YOGA experimental Godot slice. The web release remains the reference.
config_version=5

[application]
config/name="EAR YOGA · Godot prototype"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/lotus-icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="Space Music League Godot Prototype"

[display]
window/size/viewport_width=1200
window/size/viewport_height=800
window/size/window_width_override=1200
window/size/window_height_override=800
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.065, 0.10, 1)

[audio]
driver/enable_input=false
